# Resolve the current user on every request, outside the shared page cache.
tt_content.personal_data_block = COA_INT
tt_content.personal_data_block {
    10 = FLUIDTEMPLATE
    10 {
        file = EXT:personal_data_block/Resources/Private/Templates/PersonalDataBlock.fluid.html
        dataProcessing.10 = personal-data-current-user
    }
}
